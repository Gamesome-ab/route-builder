{
	"name": "@gamesome/route-builder",
	"description": "Typesafe, ergonomic javascript route-builder. No framework dependencies or magic string nonsense.",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"route-builder-generate": "./dist/cli/generate.js"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"root": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./generator": {
			"root": "./src/generator.ts",
			"types": "./dist/generator.d.ts",
			"import": "./dist/generator.js",
			"default": "./dist/generator.js"
		}
	},
	"files": [
		"dist",
		"!**/*.tsbuildinfo"
	],
	"nx": {
		"targets": {
			"build": {
				"executor": "@nx/esbuild:esbuild",
				"outputs": [
					"{options.outputPath}"
				],
				"options": {
					"outputPath": "packages/route-builder/dist",
					"main": "packages/route-builder/src/index.ts",
					"additionalEntryPoints": [
						"packages/route-builder/src/generator.ts",
						"packages/route-builder/src/cli/generate.ts"
					],
					"tsConfig": "packages/route-builder/tsconfig.lib.json",
					"format": [
						"esm"
					],
					"declarationRootDir": "packages/route-builder/src"
				}
			}
		}
	},
	"dependencies": {},
	"peerDependencies": {
		"typescript": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Gamesome-ab/route-builder.git"
	},
	"keywords": [
		"astro",
		"react",
		"svelte",
		"vue",
		"withastro"
	],
	"author": "Johan Svensson",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Gamesome-ab/route-builder/issues"
	},
	"homepage": "https://github.com/Gamesome-ab/route-builder#readme",
	"publishConfig": {
		"access": "public"
	}
}
